// SafeRide AI Database Schema (Prisma ORM with PostgreSQL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  DRIVER
  ADMIN
  FIRST_RESPONDER
}

enum Priority {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AccidentStatus {
  POSSIBLE
  CONFIRMATION_PENDING
  FALSE_ALARM
  CONFIRMED
  ESCALATED
  RESOLVED
}

enum NotificationChannel {
  SMS
  VOICE_CALL
  PUSH
  EMAIL
  SIM800L_GSM
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  fullName          String
  phoneNumber       String?
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  medicalProfile    MedicalProfile?
  emergencyContacts EmergencyContact[]
  vehicles          Vehicle[]
  accidentEvents    AccidentEvent[]
  auditLogs         AuditLog[]
}

model EmergencyContact {
  id                     String    @id @default(uuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  relationship           String
  phoneNumber            String
  priority               Priority  @default(PRIMARY)
  notifyOnConfirmation   Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model MedicalProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup          String
  allergies           String?
  chronicConditions   String?
  medications         String?
  emergencyNotes      String?
  organDonor          Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Vehicle {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleNumber  String          @unique
  makeModel      String
  year           Int?
  color          String?
  devices        Device[]
  accidentEvents AccidentEvent[]
  createdAt      DateTime        @default(now())
}

model Device {
  id             String          @id @default(uuid())
  vehicleId      String?
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  deviceId       String          @unique // e.g. ESP32_SAFERIDE_001
  firmwareVer    String          @default("2.1.0")
  status         String          @default("ONLINE")
  lastHeartbeat  DateTime        @default(now())
  sensorReadings SensorReading[]
  accidentEvents AccidentEvent[]
}

model SensorReading {
  id             String   @id @default(uuid())
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp      DateTime @default(now())
  ax             Float
  ay             Float
  az             Float
  gx             Float
  gy             Float
  gz             Float
  totalAcc       Float
  pitch          Float
  roll           Float
  speed          Float?
  csq            Int?
}

model AccidentEvent {
  id                 String           @id @default(uuid())
  userId             String?
  user               User?            @relation(fields: [userId], references: [id])
  vehicleId          String?
  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id])
  deviceId           String?
  device             Device?          @relation(fields: [deviceId], references: [id])
  timestamp          DateTime         @default(now())
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  impactScore        Float
  mlProbability      Float
  severity           SeverityLevel    @default(HIGH)
  status             AccidentStatus   @default(CONFIRMATION_PENDING)
  triggerReason      String
  confirmationExpiry DateTime?
  cancelledAt        DateTime?
  confirmedAt        DateTime?
  emergencyEvents    EmergencyEvent[]
  notifications      Notification[]
  createdAt          DateTime         @default(now())
}

model EmergencyEvent {
  id              String        @id @default(uuid())
  accidentEventId String
  accidentEvent   AccidentEvent @relation(fields: [accidentEventId], references: [id], onDelete: Cascade)
  escalationLevel Int           @default(1) // Level 1 (User), 2 (Primary), 3 (Secondary), 4 (Service)
  actionTaken     String
  timestamp       DateTime      @default(now())
}

model Notification {
  id              String              @id @default(uuid())
  accidentEventId String
  accidentEvent   AccidentEvent       @relation(fields: [accidentEventId], references: [id], onDelete: Cascade)
  recipientName   String
  recipientPhone  String
  channel         NotificationChannel @default(SMS)
  status          NotificationStatus  @default(SENT)
  messageBody     String
  sentAt          DateTime            @default(now())
}

model Location {
  id        String   @id @default(uuid())
  deviceId  String
  latitude  Float
  longitude Float
  accuracy  Float?
  speed     Float?
  timestamp DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
}
