# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file to version control.

# ---- Server ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- Database (MySQL) ----
DB_URL=jdbc:mysql://localhost:3306/project_db?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DDL_AUTO=update

# ---- JWT ----
# Generate a strong, random secret (>= 256 bits). Example:
#   openssl rand -base64 64
JWT_SECRET=replace_this_with_a_long_random_base64_secret
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
